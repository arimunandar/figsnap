{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "figsnap-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "LIBRARY", "class_name": "Library" }
    ]
  },
  // Room writes nothing. Accounts holds credentials; Library holds each
  // account's saved set, which is the only thing about a design kept anywhere.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v3", "new_sqlite_classes": ["Library"] }
  ]
}
